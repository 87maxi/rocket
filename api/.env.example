# Northwind Orders API Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=mysql://root:@localhost:3306/northwind

# Alternative database configurations (uncomment and modify as needed)
# DATABASE_URL=mysql://username:password@localhost:3306/northwind
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/northwind

# Rocket Configuration (optional - can also be set in Rocket.toml)
ROCKET_PORT=8000
ROCKET_ADDRESS=127.0.0.1

# Logging Level (optional)
RUST_LOG=info
